rules_version = '2';

// Firestore security rules for the Pretty Killer ticket site.
// Upload with: firebase deploy --only firestore:rules
// The admin page has no login, so ticket names are readable by anyone who
// knows how to query this database. Seats can't be claimed twice. Only the
// ticket holder ("Can't make it") or the admin (private admin link) can delete
// or move a ticket.

service cloud.firestore {
  match /databases/{database}/documents {

    // "Can't make it": the ticket holder's device keeps a secret key; only its
    // SHA-256 (keyHash) is stored. Writing the matching key into cancelKey, and
    // nothing else, unlocks deleting that seat and ticket.
    function keyMatches(key, hash) {
      return key is string && hash is string
          && hashing.sha256(key).toHexString().lower() == hash.lower();
    }
    function onlyAddsCancelKey() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(["cancelKey"])
          && keyMatches(request.resource.data.cancelKey, resource.data.keyHash);
    }
    function cancelUnlocked() {
      return "cancelKey" in resource.data && keyMatches(resource.data.cancelKey, resource.data.keyHash);
    }

    // Admin seat changes (move, switch, release, roll the dice, undo) use the
    // private admin link's secret. Only its SHA-256 is stored here. The admin
    // page writes the secret into adminTokens/now (which nobody can read) in
    // the same request as the seat changes, and each change checks that token.
    function isAdminKey(key) {
      return keyMatches(key, "c5659178d559cb6a6d9c16dee29e0ae3adc17de94c52925ead21f199415ed7ba");
    }
    function adminActing() {
      return getAfter(/databases/$(database)/documents/adminTokens/now).data.at == request.time
          && isAdminKey(getAfter(/databases/$(database)/documents/adminTokens/now).data.key);
    }
    match /adminTokens/{id} {
      allow read: if false;
      allow write: if request.resource.data.keys().hasOnly(["key", "at"])
                   && request.resource.data.at == request.time
                   && isAdminKey(request.resource.data.key);
    }

    // Changing which shows you're coming to (you keep your seat): the ticket
    // holder's device writes its key into ownerTokens/{id} (which nobody can
    // read) in the same request, and only missMorning / missNight can change.
    match /ownerTokens/{id} {
      allow read: if false;
      allow write: if request.resource.data.keys().hasOnly(["key", "at"])
                   && request.resource.data.at == request.time
                   && keyMatches(request.resource.data.key, get(/databases/$(database)/documents/tickets/$(id)).data.keyHash);
    }
    function ownerChangesShows(id) {
      return getAfter(/databases/$(database)/documents/ownerTokens/$(id)).data.at == request.time
          && keyMatches(getAfter(/databases/$(database)/documents/ownerTokens/$(id)).data.key, resource.data.keyHash)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["missMorning", "missNight"])
          && request.resource.data.missMorning is bool
          && request.resource.data.missNight is bool;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "finnshapiro49@gmail.com";
    }

    // seats/{show}__{seat}: public list of taken seats (no names).
    // A seat can only be created once. Creating a seat that already exists
    // counts as an update, which is refused, so each seat goes to one person.
    match /seats/{id} {
      allow read: if true;
      allow create: if adminActing()
                    || (request.resource.data.keys().hasOnly(["show", "seat", "takenAt", "keyHash"])
                    && id == request.resource.data.show + "__" + request.resource.data.seat
                    && existsAfter(/databases/$(database)/documents/tickets/$(id)));
      allow update: if adminActing() || onlyAddsCancelKey();
      allow delete: if adminActing() || isAdmin() || cancelUnlocked();
    }

    // tracklist/{show}: song names for the Pretty and Killer sides. Anyone can
    // read it; only the admin page (admin token in the same request) can save it.
    match /tracklist/{show} {
      allow read: if true;
      allow write: if adminActing()
                   && request.resource.data.keys().hasOnly(["pretty", "killer", "prettyStart", "killerStart", "prettyLen", "killerLen", "updatedAt"])
                   && request.resource.data.pretty is list && request.resource.data.pretty.size() <= 30
                   && request.resource.data.killer is list && request.resource.data.killer.size() <= 30;
    }

    // live/{show}: "now playing" (which side and song, how far into it, when, playing or paused).
    match /live/{show} {
      allow read: if true;
      allow write: if adminActing()
                   && request.resource.data.keys().hasOnly(["side", "index", "pos", "startedAt", "on", "playing", "dur"]);
    }

    // showtimes/{show}: when the Pretty show started (set by the admin page).
    match /showtimes/{show} {
      allow read: if true;
      allow create, update: if adminActing() && request.resource.data.keys().hasOnly(["prettyStart"]);
      allow delete: if adminActing();
    }

    // guestbook/{id}: anyone can leave a message, starting 50 minutes after the
    // Pretty show starts; it only shows on the site
    // after the admin approves it. Only the admin can approve, hide or delete.
    match /guestbook/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["name", "message", "approved", "createdAt"])
                    && exists(/databases/$(database)/documents/showtimes/prettykiller)
                    && request.time >= get(/databases/$(database)/documents/showtimes/prettykiller).data.prettyStart + duration.value(50, "m")
                    && request.resource.data.approved == false
                    && request.resource.data.createdAt == request.time
                    && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 40
                    && request.resource.data.message is string && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 280;
      allow update: if adminActing() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["approved"]);
      allow delete: if adminActing();
    }

    // votes/{id}: one list of favorite songs per vote. Can't be changed; only
    // the admin can delete (reset) votes.
    match /votes/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["picks", "createdAt"])
                    && request.resource.data.picks is list
                    && request.resource.data.picks.size() > 0 && request.resource.data.picks.size() <= 6
                    && request.resource.data.createdAt == request.time;
      allow delete: if adminActing();
    }

    // tickets/{show}__{seat}: the ticket with the person's name.
    // Anyone can claim (create) one and read the list (the admin page has no login).
    match /tickets/{id} {
      allow create: if adminActing()
                    || (request.resource.data.keys().hasOnly(["show", "seat", "area", "name", "relation", "code", "createdAt", "keyHash", "missMorning", "missNight"])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.relation in ["friend", "family"]
                    && (!("missMorning" in request.resource.data) || request.resource.data.missMorning is bool)
                    && (!("missNight" in request.resource.data) || request.resource.data.missNight is bool)
                    && id == request.resource.data.show + "__" + request.resource.data.seat
                    && existsAfter(/databases/$(database)/documents/seats/$(id)));
      allow read: if true;
      allow update: if adminActing() || onlyAddsCancelKey() || ownerChangesShows(id);
      allow delete: if adminActing() || isAdmin() || cancelUnlocked();
    }
  }
}
