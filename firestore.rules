rules_version = '2';

// Firestore security rules for the Pretty Killer ticket site.
// Paste these into Firebase console → Firestore Database → Rules, then Publish.
// Replace YOUR-ADMIN-EMAIL@example.com with the email of your admin login
// (the same email you put in CONFIG.adminEmail in index.html).

service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == "YOUR-ADMIN-EMAIL@example.com";
    }

    // seats/{show}__{seat}: public list of taken seats (no names).
    // A seat can only be created once. Creating a seat that already exists
    // counts as an update, which is refused, so each seat goes to one person.
    match /seats/{id} {
      allow read: if true;
      allow create: if request.resource.data.keys().hasOnly(["show", "seat", "takenAt"])
                    && id == request.resource.data.show + "__" + request.resource.data.seat
                    && existsAfter(/databases/$(database)/documents/tickets/$(id));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // tickets/{show}__{seat}: the private ticket with the person's name.
    // Anyone can claim (create) one; only the admin can read or release them.
    match /tickets/{id} {
      allow create: if request.resource.data.keys().hasOnly(["show", "seat", "area", "name", "relation", "code", "createdAt"])
                    && request.resource.data.name is string
                    && request.resource.data.name.size() > 0
                    && request.resource.data.name.size() <= 60
                    && request.resource.data.relation in ["friend", "family"]
                    && id == request.resource.data.show + "__" + request.resource.data.seat
                    && existsAfter(/databases/$(database)/documents/seats/$(id));
      allow read, delete: if isAdmin();
      allow update: if false;
    }
  }
}
